# MongoDB connection string used by the bookmarks serverless function.
# Get this from MongoDB Atlas (or your own MongoDB) and set it in Vercel:
#   Vercel > Project > Settings > Environment Variables > MONGODB_URI
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Optional overrides (defaults shown).
MONGODB_DB=indian_translator
MONGODB_BOOKMARKS_COLLECTION=bookmarks
